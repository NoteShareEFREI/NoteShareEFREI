<!DOCTYPE html>
<html lang="en">
<head>
    <link rel="stylesheet" href="/css/styles.css">
    <meta charset="UTF-8">
    <title>Admin - Manage Categories</title>
</head>
<body>

    <!-- Top Section -->
    <header class="topbar">
        <a href="/home" class="home-link">
            <span class="home-link-icon">←</span>
            <span>Back to Home</span>
        </a>
        <div class="search">
            <h1 class="logo" style="margin: 0;">Category Management</h1>
        </div>
        <nav class="nav">
            <a href="/account">Account</a>
        </nav>
        <nav class="nav">
            <a href="/home">Home</a>
        </nav>
    </header>

    <div class="main main-vertical">
        <main class="content">

            <!-- Add Category Section -->
            <section class="section">
                <h2 class="section-title">Add New Category</h2>
                <form method="POST" class="insert_in_page" style="max-width: none; margin: 0; box-shadow: none; border: none; padding: 0;">
                    <input type="hidden" name="action" value="add_category">
                    <input
                        type="text"
                        name="category_name"
                        placeholder="Enter category name"
                        required
                    >
                    <button type="submit">
                        Add Category
                    </button>
                </form>
            </section>

            <!-- Add Subcategory Section -->
            <section class="section">
                <h2 class="section-title">Add New Subcategory</h2>
                <form method="POST" class="insert_in_page" style="max-width: none; margin: 0; box-shadow: none; border: none; padding: 0;">
                    <input type="hidden" name="action" value="add_subcategory">
                    <select name="category_id" required style="margin-bottom: 16px;">
                        <option value="">Select a category</option>
                        {{range .Categories}}
                        <option value="{{.Id}}">{{.Name}}</option>
                        {{end}}
                    </select>
                    <input
                        type="text"
                        name="subcategory_name"
                        placeholder="Enter subcategory name"
                        required
                    >
                    <button type="submit">
                        Add Subcategory
                    </button>
                </form>
            </section>

            <!-- Categories and Subcategories List -->
            <section class="section">
                <h2 class="section-title">Categories & Subcategories</h2>

                {{if .Categories}}
                    <div class="results">
                        {{range .Categories}}
                        {{$category := .}}
                        <article class="result-card">
                            <div class="section-header">
                                <h4>{{$category.Name}} (ID: {{$category.Id}})</h4>
                                <div class="actions">
                                    <form method="POST" style="display: inline;">
                                        <input type="hidden" name="action" value="delete_category">
                                        <input type="hidden" name="category_id" value="{{$category.Id}}">
                                        <button
                                            type="submit"
                                            onclick="return confirm('Are you sure you want to delete this category and all its subcategories?');"
                                            class="actions button"
                                            style="background: #ef4444; color: white; border: none;"
                                        >
                                            Delete Category
                                        </button>
                                    </form>
                                </div>
                            </div>

                            <!-- Subcategories for this category -->
                            <div style="margin-top: 16px;">
                                <h5 style="color: var(--muted); margin-bottom: 8px;">Subcategories:</h5>
                                {{range $.SubCategories}}
                                {{if eq .CategoryId $category.Id}}
                                <div style="display: inline-block; margin: 4px 8px 4px 0; padding: 4px 8px; background: light-dark(#f8f9fa, #2a2a2a); border-radius: 4px; font-size: 12px;">
                                    {{.Name}} (ID: {{.Id}})
                                    <form method="POST" style="display: inline; margin-left: 8px;">
                                        <input type="hidden" name="action" value="delete_subcategory">
                                        <input type="hidden" name="subcategory_id" value="{{.Id}}">
                                        <button
                                            type="submit"
                                            onclick="return confirm('Are you sure you want to delete this subcategory?');"
                                            style="background: none; border: none; color: #ef4444; cursor: pointer; font-size: 10px; padding: 0; margin-left: 4px;"
                                        >
                                            ✕
                                        </button>
                                    </form>
                                </div>
                                {{end}}
                                {{end}}
                            </div>
                        </article>
                        {{end}}
                    </div>
                {{else}}
                    <div class="empty">
                        No categories found
                    </div>
                {{end}}
            </section>

        </main>
    </div>

</body>
</html>

