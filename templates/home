<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NoteShare - Home</title>
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>

<header class="topbar">

    <h2 class="logo">NoteShare</h2>

    <form action="/home" method="get" class="search">
        <input
            class="search-input"
            name="q"
            type="text"
            value="{{.Query}}"
            placeholder="Search a category or a study sheet"
        >
    </form>

    <nav class="nav">
        <a href="/account">Account</a>
        <a href="/login">Log in</a>
    </nav>

</header>


<main class="main">


    <section class="section">
        <h3 class="section-title">Categories</h3>

        <div class="categories">

            <a href="/home?category=maths" class="card">
                <strong>Maths</strong>
                <p>Calculus, Linear Algebra ...</p>
            </a>

            <a href="/home?category=physics" class="card">
                <strong>Physics</strong>
                <p>Digital system, transmitions channel ...</p>
            </a>

            <a href="/home?category=programming" class="card">
                <strong>Programming</strong>
                <p>Python, C, Cloud Computing, Sustainable Digital</p>
            </a>

            <a href="/home?category=formation_generale" class="card">
                <strong>Formation_generale</strong>
                <p>Communication, Anglais</p>
            </a>
        </div>
    </section>

    <section class="section">

        <h3 class="section-title">Search results</h3>

        <div class="results">

            {{range .Results}}
            <article class="result-card">
                <h4>{{.Title}}</h4>
                <p class="category">{{.Category}}</p>
                <p>{{.Description}}</p>
            </article>
            {{else}}
            <div class="empty">
                No study sheet matches your search.
            </div>
            {{end}}

        </div>

    </section>

</main>

</body>
</html>