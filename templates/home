<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>NoteShare - Home</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/styles.css">
    <script>
        addsheetmode = false;
        function toggle_add_sheet_mode(){
            addsheetmode = !addsheetmode;
            document.getElementById("studysheetuploadform").hidden = !addsheetmode;
        } 
        function doSubmit(){
            if (confirm("Validate the submission of the study sheet:")){
                return true;
            } else {
                return false;
            }
        }
        const subs = JSON.parse({{.SubCategoriesJSON}});
        function updateSubcategories() {
            const catId = parseInt(document.getElementById('category').value);
            const subSelect = document.getElementById('subcategory');
            subSelect.innerHTML = '';
            subs.forEach(sub => {
                if (sub.CategoryId === catId) {
                    const opt = document.createElement('option');
                    opt.value = sub.Name;
                    opt.text = sub.Name;
                    subSelect.appendChild(opt);
                }
            });
        }
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('category').addEventListener('change', updateSubcategories);
            updateSubcategories(); // initial load
        });
    </script>
</head>

<body>

<header class="topbar">

    <h2 class="logo">NoteShare</h2>

    <form action="/home" method="get" class="search">
        <input
            class="search-input"
            name="q"
            type="text"
            value="{{.Query}}"
            placeholder="Search a category or a study sheet"
        >
    </form>

    <nav class="nav">
        <a href="/account">Account</a>
        {{if .IsLoggedIn}}
        <a href="/logout">Log out</a>
        {{else}}
        <a href="/login">Log in</a>
        {{end}}
    </nav>

</header>


<main class="main">


    <section class="section">
        

        <h3 class="section-title">Categories</h3>

        <div class="categories">

            <a href="/home?category=maths" class="card">
                <strong>Maths</strong>
                <p>Calculus, Linear Algebra ...</p>
            </a>

            <a href="/home?category=physics" class="card">
                <strong>Physics</strong>
                <p>Digital system, transmitions channel ...</p>
            </a>

            <a href="/home?category=programming" class="card">
                <strong>Programming</strong>
                <p>Python, C, Cloud Computing, Sustainable Digital</p>
            </a>

            <a href="/home?category=formation_generale" class="card">
                <strong>Formation_generale</strong>
                <p>Communication, Anglais</p>
            </a>
        </div>
    </section>

    <section class="section">

        <h3 class="section-title">Search results</h3>

        <div class="results">

            {{range .Results}}
            <article class="result-card">
                <h4>{{.Title}}</h4>
                <p class="category">{{.Category}}</p>
                <p>{{.Description}}</p>
            </article>
            {{else}}
            <div class="empty">
                No study sheet matches your search.
            </div>
            {{end}}
    </section>

    {{if .IsLoggedIn}}
    <section class="section">

        <div class="section-header">
            <h3 class="section-title">Study Sheet Creation</h3>

            <div class="actions">
                <button onclick="toggle_add_sheet_mode()">Create study Sheet</button>

                <form id="studysheetuploadform"
                      action="createsheet"
                      method="POST"
                      enctype="multipart/form-data"
                      onsubmit="doSubmit()"
                      hidden>

                    <label for="title">Title:</label>
                    <input type="text" id="title" name="title" required>

                    <br>
                    <label for="category">Category:</label>
                    <select id="category" name="category" required>
                        {{range .Categories}}
                        <option value="{{.Id}}">{{.Name}}</option>
                        {{end}}
                    </select>

                    <br>
                    <label for="subcategory">Subcategory:</label>
                    <select id="subcategory" name="subcategory" required>
                    </select>

                    <br>
                    <label for="studysheet">Upload a studysheet:</label>
                    <input type="file" id="studysheet" name="studysheet"
                           accept="application/pdf, text/plain"/>

                    <br>
                    <button type="submit">Submit studysheet</button>
                </form>
            </div>
        </div>

    </section>
    {{end}}
</main>

</body>
</html>